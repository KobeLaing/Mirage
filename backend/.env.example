# Copy to backend/.env and adjust. Every value here is a safe local default;
# there are no secrets in this app yet. Never commit a real .env.

ENVIRONMENT=development
# Swap for PostgreSQL with e.g. postgresql+psycopg://user:pass@host/mirage
# (then install a driver such as psycopg). Relative paths are relative to backend/.
DATABASE_URL=sqlite:///./var/mirage.db
UPLOAD_DIR=./var/uploads
PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# dev_header = trust the X-User-Id header from the account switcher. Refused in production.
AUTH_MODE=dev_header

MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_IMAGE_PIXELS=40000000

RATE_LIMIT_POSTS_PER_HOUR=10
RATE_LIMIT_VOTES_PER_MINUTE=120
RATE_LIMIT_REACTIONS_PER_MINUTE=120

LOG_LEVEL=INFO
SEED_MEDIA_DIR=../seed-media
