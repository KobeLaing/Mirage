# Copy to backend/.env and fill in the secrets. backend/.env is gitignored;
# never commit a real one. Every non-secret value here is a safe local default.

ENVIRONMENT=development
# Swap for PostgreSQL with e.g. postgresql+psycopg://user:pass@host/mirage
# (then install a driver such as psycopg). Relative paths are relative to backend/.
DATABASE_URL=sqlite:///./var/mirage.db
UPLOAD_DIR=./var/uploads
PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# REQUIRED. Signs session cookies; the API refuses to start without it.
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-value
SESSION_TTL_MINUTES=240
# Browsers accept Secure cookies on http://localhost, so leave this on.
COOKIE_SECURE=true

MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_IMAGE_PIXELS=40000000

RATE_LIMIT_POSTS_PER_HOUR=10
RATE_LIMIT_VOTES_PER_MINUTE=120
RATE_LIMIT_REACTIONS_PER_MINUTE=120
RATE_LIMIT_COMMENTS_PER_MINUTE=10
RATE_LIMIT_SCANS_PER_HOUR=20
# Per 15 minutes.
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_USERNAME=10

LOG_LEVEL=INFO
SEED_MEDIA_DIR=../seed-media

# Passwords for the seeded demo accounts (read only by `python -m scripts.seed`).
SEED_KOBE_PASSWORD=change-me
SEED_KARA_PASSWORD=change-me
SEED_ALTAIR_PASSWORD=change-me
SEED_JOSIE_PASSWORD=change-me
SEED_TERRA_PASSWORD=change-me
SEED_RIVER_PASSWORD=change-me

# Optional: path to an ONNX face-swap classifier for the scanner. Leave empty to
# skip that check. See README, "AI Authenticity Scanner".
DEEPFAKE_MODEL_PATH=

# Future third-party detectors read their API keys from here, e.g.:
# HIVE_API_KEY=
# SIGHTENGINE_API_KEY=
